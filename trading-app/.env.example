# paper = simulated fills (default, safe). live = real orders on Liquid.
TRADING_MODE=paper
# Must be set to "I_UNDERSTAND" in addition to TRADING_MODE=live before real orders are sent.
LIVE_TRADING_CONFIRM=

# Market data source for paper trading: "simulated" (offline random walk) or "liquid"
MARKET_DATA=simulated

# Liquid API connection
LIQUID_API_BASE=https://api.liquid.trade
LIQUID_API_KEY=
LIQUID_API_SECRET=
# Optional JSON file overriding endpoint paths/field names (see liquid_endpoints.example.json)
LIQUID_ENDPOINTS_FILE=

# Paper account
PAPER_STARTING_CASH=10000
PAPER_FEE_RATE=0.0005

# Risk limits (apply in both modes)
MAX_ORDER_NOTIONAL=1000
MAX_POSITION_NOTIONAL=5000
MAX_DAILY_LOSS=500
